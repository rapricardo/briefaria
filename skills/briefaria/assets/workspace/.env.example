# Maquina de Producao — Chaves de API
# Copie este arquivo para .env e preencha com suas chaves:
#   cp .env.example .env

# fal.ai — geracao de imagens (Nano Banana 2) e clips de video (Gemini Omni Flash / Veo / Kling)
# Criar em: https://fal.ai/dashboard/keys
# Necessária para os backends fal.ai
FAL_KEY=""

# Google AI Studio — geracao de imagens via Gemini (alternativa ao Nano Banana 2)
# Criar em: https://aistudio.google.com/apikey
# Opcional: so precisa se usar --backend gemini no imagen.py
GEMINI_API_KEY=""

# ElevenLabs — voice-over e efeitos sonoros
# Criar em: https://elevenlabs.io/app/settings/api-keys
# Opcional: so precisa se usar voiceover/SFX separados (a engine de video ja gera audio ambiente)
ELEVENLABS_API_KEY=""

GLM_API_KEY=""
CLICKUP_TOKEN=""
CLICKUP_BRANDING_FIELDS=""
